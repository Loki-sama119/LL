<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Xác nhận xóa</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<main class="wrap narrow"><a class="back" href="${pageContext.request.contextPath}/products">← Danh sách sản phẩm</a><div class="panel form"><h1>Xóa sản phẩm?</h1><p>Thao tác này sẽ xóa sản phẩm <strong><c:out value="${product.name}"/></strong> (ID: <c:out value="${product.id}"/>) khỏi cơ sở dữ liệu.</p><p class="muted">Bạn cần xác nhận trước khi xóa.</p>
<form method="post" action="${pageContext.request.contextPath}/products?action=delete"><input type="hidden" name="id" value="${product.id}"><div class="form-actions"><button class="btn primary destructive" type="submit">Xác nhận xóa</button><a class="btn" href="${pageContext.request.contextPath}/products">Hủy bỏ</a></div></form></div></main></body></html>
